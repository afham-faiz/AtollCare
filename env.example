# Copy this file to inputs/.env and fill in your own keys.
# inputs/ is git-ignored, so your keys and recordings never get committed.
# Restart the server after editing.

# ===== Presage (face video -> heart rate and breathing rate) ================
# Get a key at https://physiology.presagetech.com
# sdk = real readings, mock = fake numbers (no key needed)
PRESAGE_MODE=sdk
PRESAGE_API_KEY=

# ===== Gemini (voice transcription, chat) ===================================
# Leave GEMINI_API_KEY blank to run the voice part in mock mode.
GEMINI_API_KEY=

# Which kind of Google API key is this?
#   true   a Google Cloud / Agent Platform (Vertex AI) key. Its API restrictions must allow the
#          Vertex AI / Agent Platform API, otherwise Google answers API_KEY_SERVICE_BLOCKED.
#   false  a Google AI Studio key (starts with AIza)
GEMINI_USE_ENTERPRISE=false

# If Google does not answer a request within this many seconds, give up with an error instead of waiting
# forever, and try again up to GEMINI_RETRY_ATTEMPTS times in total (1 = no retry).
GEMINI_TIMEOUT_S=150
GEMINI_RETRY_ATTEMPTS=2

# Speech-to-text model. "flash" models send each sentence after a pause. Models with "live" in the
# name stream while you speak, but Google refuses them for express-mode API keys at the moment.
GEMINI_STT_MODEL=gemini-3.8-flash

# Backup used automatically if the main model cannot start. Blank = no backup.
GEMINI_STT_FALLBACK_MODEL=

# Model for chat.py
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Model that reads ID documents (driving licence, national ID) from a photo.
GEMINI_ID_MODEL=gemini-3.8-flash

# Visual cues: the planner reads the transcript and chooses which cues to look for; the inspector
# looks at frames from the video and reports what is actually visible.
GEMINI_CUE_PLANNER_MODEL=gemini-3.8-flash
GEMINI_VQA_MODEL=gemini-3.8-flash
# Take one frame every this many seconds (never more than VQA_MAX_FRAMES frames in total).
VQA_FRAME_INTERVAL_S=2
VQA_MAX_FRAMES=24

# How the video is checked for visible signs:
#   one_pass  ONE request: the frames, the voice account and every sign go into a single prompt, and the
#             model must answer each sign separately (was it mentioned? what do the frames show?).
#   two_step  a first request reads only the account and picks which signs to look for; a second request
#             sees only the frames and those signs, so it never sees the account.
VQA_MODE=one_pass

# Recording video with the camera on the page: it stops by itself after this many seconds.
# (Presage needs about 45 to 60 seconds for a reliable breathing rate.)
VIDEO_RECORD_MAX_S=60

# ===== Hand-off to the crew app (the teammate's engine) ========================
# Their FastAPI engine. Run it on a different port from this page (this page uses 8000).
ENGINE_URL=http://127.0.0.1:8010
# Their web app, used only to build the "open on the crew screen" link.
ENGINE_WEB_URL=http://localhost:3000
# Give up on the engine if it does not answer within this many seconds.
ENGINE_TIMEOUT_S=15
# What goes in their patient label. Real names and ID numbers are NEVER sent.
#   initials  for example "D. M."
#   none      no label at all
HANDSHAKE_PATIENT_LABEL=initials
# Condenses the voice account into their one-line "complaint".
GEMINI_SUMMARY_MODEL=gemini-3.8-flash
# "Alert and responsive" seen in the video can be sent as consciousness A. Their app only has the sources
# presage, manual and simulated, so it would show as a crew entry. Keep false until they add an AI-video source.
HANDSHAKE_SEND_CONSCIOUSNESS=false
HANDSHAKE_CONSCIOUSNESS_MIN_CONFIDENCE=0.7

# Language spoken, as a code (en-US), or blank to auto-detect.
TRANSCRIBE_LANGUAGE=en-US

# Seconds of silence (after speech) before the page stops recording by itself.
STT_SILENCE_STOP_S=2

# Flash only: a pause this long ends a sentence; speech longer than the max is sent in pieces.
STT_FLASH_PAUSE_S=0.8
STT_FLASH_MAX_SEGMENT_S=8

# ===== Recording every trial ================================================
# true = keep each voice recording (.wav) and each analysed video (.mp4) in recordings/ for replay.
SAVE_RECORDINGS=true

