# Copy this file to inputs/.env and fill in your own keys.
# inputs/ is git-ignored, so your keys and recordings never get committed.
# Restart the server after editing.

# ===== Presage (face video -> heart rate and breathing rate) ================
# Get a key at https://physiology.presagetech.com
# sdk = real readings, mock = fake numbers (no key needed)
PRESAGE_MODE=sdk
PRESAGE_API_KEY=

# ===== Gemini (voice transcription, chat) ===================================
# Leave GEMINI_API_KEY blank to run the voice part in mock mode.
GEMINI_API_KEY=

# Which Google platform the key belongs to:
#   developer   Google AI Studio key (starts with AIza)
#   enterprise  Google Cloud / Vertex AI key ("Gemini Enterprise Agent Platform").
#               The key's API restrictions must allow the Vertex AI / Agent Platform API.
#   auto        guess from the key's format
GEMINI_PLATFORM=enterprise

# Speech-to-text model. "flash" models send each sentence after a pause. Models with "live" in the
# name stream while you speak, but Google refuses them for express-mode API keys at the moment.
GEMINI_STT_MODEL=gemini-3.8-flash

# Backup used automatically if the main model cannot start. Blank = no backup.
GEMINI_STT_FALLBACK_MODEL=

# Model for chat.py
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Language spoken, as a code (en-US), or blank to auto-detect.
TRANSCRIBE_LANGUAGE=en-US

# Seconds of silence (after speech) before the page stops recording by itself.
STT_SILENCE_STOP_S=2

# Flash only: a pause this long ends a sentence; speech longer than the max is sent in pieces.
STT_FLASH_PAUSE_S=0.8
STT_FLASH_MAX_SEGMENT_S=8

# ===== Recording every trial ================================================
# true = keep each voice recording (.wav) and each analysed video (.mp4) in recordings/ for replay.
SAVE_RECORDINGS=true
