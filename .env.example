# ── engine ────────────────────────────────────────────────────────────────────
# Tiger Cloud / TimescaleDB URL (…?sslmode=require). Empty = in-memory store (data resets on restart).
DATABASE_URL=postgresql://postgres:postgres@db:5432/atollcare
# Vultr: <ip>.sslip.io or your domain
PUBLIC_HOST=localhost
CORS_ORIGINS=http://localhost:3000

# Adapters: real | mock. A missing key falls back to mock with a log line.
GEMINI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

ELEVENLABS_MODE=mock
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# Optional voice ids; empty = ElevenLabs premade defaults
ELEVENLABS_VOICE_CREW=
ELEVENLABS_VOICE_HOSPITAL=

# Cached TTS audio: local | s3
STORAGE_MODE=local
S3_ENDPOINT=https://<region>.vultrobjects.com
S3_BUCKET=atollcare
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Demo defaults
DEFAULT_REGION=maldives
DEFAULT_SPEED_MULTIPLIER=1

# Hosting label in the presenter panel. Normally detected from the Vultr instance metadata service; set only if it
# shows "This computer" after deploying (e.g. HOST_LABEL=Vultr, HOST_REGION=lhr). METADATA_URL= (empty) disables it.
HOST_LABEL=
HOST_REGION=

# ── web ───────────────────────────────────────────────────────────────────────
# Caddy (prod) and the Next.js dev proxy route /api → engine
NEXT_PUBLIC_ENGINE_URL=/api
# Presage bridge on the vehicle laptop
NEXT_PUBLIC_PRESAGE_BRIDGE_URL=ws://localhost:8787/ws

# ── presage-bridge (crew laptop) ──────────────────────────────────────────────
# Read with: cd presage-bridge && node --env-file=../.env src/index.js
# ENGINE_URL = http://localhost:8000 locally, or https://<server-ip>.sslip.io once deployed to Vultr.
PRESAGE_API_KEY=
ENGINE_URL=http://localhost:8000
