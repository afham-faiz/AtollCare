# Core
# or Tiger Cloud URL (…?sslmode=require); empty = in-memory store
DATABASE_URL=postgresql://postgres:postgres@db:5432/atollcare
# Vultr: <ip>.sslip.io or your domain
PUBLIC_HOST=localhost
# Caddy proxies /api → engine
NEXT_PUBLIC_ENGINE_URL=/api
CORS_ORIGINS=http://localhost:3000

# Adapters: real | mock (presage: sdk | cloud | mock | manual)
GEMINI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

ELEVENLABS_MODE=mock
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_VOICE_GUIDE=
ELEVENLABS_VOICE_STATUS=

PRESAGE_MODE=mock
PRESAGE_API_KEY=
PRESAGE_API_URL=
PRESAGE_SDK_PATH=

# local | s3
STORAGE_MODE=local
S3_ENDPOINT=https://<region>.vultrobjects.com
S3_BUCKET=atollcare
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Demo
DEFAULT_SPEED_MULTIPLIER=1
TIMEZONE=Indian/Maldives

# Optional: map tiles (default OpenStreetMap standard tiles)
NEXT_PUBLIC_MAP_TILES=
