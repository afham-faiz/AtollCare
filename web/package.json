{
  "name": "atollcare-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "cd ../engine && uv run python -m app.openapi_dump ../web/openapi.json && cd ../web && openapi-typescript openapi.json -o src/lib/api-types.ts",
    "test": "bun test src"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "recharts": "3.10.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "sass": "1.106.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
